#!/usr/bin/env bats
# P0: Upgrade Safety Tests - CRITICAL
# These tests ensure upgrades never destroy project-specific content

load 'test_helper'

setup() {
    # Create isolated temp directory for each test
    TEST_DIR="$(mktemp -d)"
    export TEST_DIR
}

teardown() {
    # Clean up temp directory
    [[ -d "$TEST_DIR" ]] && rm -rf "$TEST_DIR"
}

# Test 1: Upgrade on non-existent file fails
@test "upgrade fails when no AGENTS.md exists" {
    run "$GENERATE_SCRIPT" --upgrade --path="$TEST_DIR"
    [ "$status" -ne 0 ]
    [[ "$output" == *"No AGENTS.md found"* ]] || [[ "$output" == *"does not exist"* ]]
}

# Test 2: Upgrade on file WITHOUT markers REFUSES
@test "upgrade refuses file without markers" {
    create_agents_without_markers "$TEST_DIR"
    
    run "$GENERATE_SCRIPT" --upgrade --path="$TEST_DIR"
    [ "$status" -ne 0 ]
    [[ "$output" == *"lacks framework markers"* ]] || [[ "$output" == *"REFUSING"* ]] || [[ "$output" == *"markers"* ]]
}

# Test 3: Upgrade dry-run shows diff
@test "upgrade dry-run shows preview without changes" {
    create_agents_with_markers "$TEST_DIR"
    
    run "$GENERATE_SCRIPT" --upgrade --path="$TEST_DIR"
    [ "$status" -eq 0 ]
    [[ "$output" == *"PREVIEW"* ]] || [[ "$output" == *"preview"* ]] || [[ "$output" == *"No changes made"* ]]
}

# Test 4: Upgrade dry-run writes nothing
@test "upgrade dry-run does not modify file" {
    create_agents_with_markers "$TEST_DIR"
    local original_content
    original_content=$(cat "$TEST_DIR/AGENTS.md")
    
    run "$GENERATE_SCRIPT" --upgrade --path="$TEST_DIR"
    [ "$status" -eq 0 ]
    
    local new_content
    new_content=$(cat "$TEST_DIR/AGENTS.md")
    [ "$original_content" = "$new_content" ]
}

# Test 5: Upgrade --apply creates backup
@test "upgrade --apply creates backup file" {
    create_agents_with_markers "$TEST_DIR"
    
    run "$GENERATE_SCRIPT" --upgrade --apply --path="$TEST_DIR"
    [ "$status" -eq 0 ]
    [ -f "$TEST_DIR/AGENTS.md.backup" ]
}

# Test 6: Upgrade --apply modifies original
@test "upgrade --apply modifies original file" {
    create_agents_with_markers "$TEST_DIR"
    local original_hash
    original_hash=$(md5sum "$TEST_DIR/AGENTS.md" 2>/dev/null || md5 -q "$TEST_DIR/AGENTS.md")
    
    run "$GENERATE_SCRIPT" --upgrade --apply --path="$TEST_DIR"
    [ "$status" -eq 0 ]
    
    local new_hash
    new_hash=$(md5sum "$TEST_DIR/AGENTS.md" 2>/dev/null || md5 -q "$TEST_DIR/AGENTS.md")
    [ "$original_hash" != "$new_hash" ]
}

# Test 7: Project-specific content preserved after upgrade
@test "project-specific content preserved after upgrade" {
    create_agents_with_markers "$TEST_DIR"
    
    run "$GENERATE_SCRIPT" --upgrade --apply --path="$TEST_DIR"
    [ "$status" -eq 0 ]
    
    # Check project-specific content is still there
    assert_file_contains "$TEST_DIR/AGENTS.md" "Project-Specific Rules"
    assert_file_contains "$TEST_DIR/AGENTS.md" "My Custom Rule"
    assert_file_contains "$TEST_DIR/AGENTS.md" "feature branches"
}

# Test 8: Content before start marker preserved
@test "content before framework markers preserved" {
    create_agents_with_markers "$TEST_DIR"
    
    run "$GENERATE_SCRIPT" --upgrade --apply --path="$TEST_DIR"
    [ "$status" -eq 0 ]
    
    # Header content should be preserved
    assert_file_contains "$TEST_DIR/AGENTS.md" "AI Agent Guidelines"
    assert_file_contains "$TEST_DIR/AGENTS.md" "Generated by"
}

# Test 9: Framework content replaced with new version
@test "framework content updated during upgrade" {
    create_agents_with_markers "$TEST_DIR"
    
    run "$GENERATE_SCRIPT" --upgrade --apply --path="$TEST_DIR"
    [ "$status" -eq 0 ]
    
    # Should contain current framework version markers
    assert_file_contains "$TEST_DIR/AGENTS.md" "GOLDEN:framework:start"
    assert_file_contains "$TEST_DIR/AGENTS.md" "GOLDEN:framework:end"
}

# Test 10: Backup contains original content exactly
@test "backup contains original content" {
    create_agents_with_markers "$TEST_DIR"
    local original_content
    original_content=$(cat "$TEST_DIR/AGENTS.md")
    
    run "$GENERATE_SCRIPT" --upgrade --apply --path="$TEST_DIR"
    [ "$status" -eq 0 ]
    
    local backup_content
    backup_content=$(cat "$TEST_DIR/AGENTS.md.backup")
    [ "$original_content" = "$backup_content" ]
}


# Test 11: Header parse ignores stray lines that mention Type or Languages
@test "upgrade reads Languages and Type from the generated header lines only" {
    create_agents_with_markers "$TEST_DIR" "python" "web-apps"
    # Stray prose above the header that used to win the unanchored grep
    sed -i.orig '1a\
Type of thing: no.\
Languages we avoid: perl
' "$TEST_DIR/AGENTS.md"
    rm "$TEST_DIR/AGENTS.md.orig"

    run "$GENERATE_SCRIPT" --upgrade --path="$TEST_DIR"
    [ "$status" -eq 0 ]
    [[ "$output" == *"Languages: python"* ]]
    [[ "$output" == *"Type: web-apps"* ]]
}

# Test 12: No header Type line means general
@test "upgrade treats a missing Type header as general" {
    {
        echo "# Guide"
        echo "Type of thing: no."
        echo "<!-- GOLDEN:framework:start -->"
        echo "x"
        echo "<!-- GOLDEN:framework:end -->"
    } > "$TEST_DIR/AGENTS.md"

    run "$GENERATE_SCRIPT" --upgrade --language=go --path="$TEST_DIR"
    [ "$status" -eq 0 ]
    [[ "$output" == *"Type: general"* ]]
}

@test "upgrade --apply replaces a generated CLAUDE.md and removes a generated CODEX.md" {
    create_agents_with_markers "$TEST_DIR"
    printf '# Claude Code Instructions\n\nSee **[AGENTS.md](./AGENTS.md)** for all AI guidance.\n' > "$TEST_DIR/CLAUDE.md"
    printf '# OpenAI Codex CLI Instructions\n\nSee **[AGENTS.md](./AGENTS.md)** for all AI guidance.\n' > "$TEST_DIR/CODEX.md"

    run "$GENERATE_SCRIPT" --upgrade --apply --language=go --path="$TEST_DIR"
    [ "$status" -eq 0 ]
    grep -qxF '@AGENTS.md' "$TEST_DIR/CLAUDE.md"
    grep -qxF '<!-- golden-agents:generated -->' "$TEST_DIR/CLAUDE.md"
    [ ! -e "$TEST_DIR/CODEX.md" ]
    [ -f "$TEST_DIR/CLAUDE.md."*.bak ]
    [ -f "$TEST_DIR/CODEX.md."*.bak ]
}

@test "upgrade --apply leaves a hand-written CODEX.md in place" {
    create_agents_with_markers "$TEST_DIR"
    printf 'Codex: run make check before commit\n' > "$TEST_DIR/CODEX.md"

    run "$GENERATE_SCRIPT" --upgrade --apply --language=go --path="$TEST_DIR"
    [ "$status" -eq 0 ]
    [ "$(cat "$TEST_DIR/CODEX.md")" = "Codex: run make check before commit" ]
    [ ! -e "$TEST_DIR/CODEX.md."*.bak ]
}

@test "upgrade keeps coverage prose that is not a backtick command" {
    mkdir -p "$TEST_DIR"
    cat > "$TEST_DIR/AGENTS.md" << 'EOF'
# AI Agent Guidelines - TestProject

> **Generated by**: [golden-agents](https://github.com/bordenet/golden-agents) v1.4.0 (progressive)
> **Last Updated**: 2026-09-11
> **Languages**: javascript
> **Type**: web-apps

<!-- GOLDEN:framework:start -->

## Quality Gates

1. **Lint**: `npm run lint`
2. **Build**: `npm run build`
3. **Test**: `npm test`
4. **Coverage**: Minimum 70%. Follow the [coverage policy](wiki/coverage.md).

<!-- GOLDEN:framework:end -->

UNIQUE_TAIL_LINE
EOF

    run "$GENERATE_SCRIPT" --upgrade --apply --path="$TEST_DIR"
    [ "$status" -eq 0 ]
    grep -F '4. **Coverage**: Minimum 70%. Follow the [coverage policy](wiki/coverage.md).' "$TEST_DIR/AGENTS.md"
    grep -qxF 'UNIQUE_TAIL_LINE' "$TEST_DIR/AGENTS.md"
}

@test "upgrade keeps numbered quality gates that are not lint build test or coverage" {
    mkdir -p "$TEST_DIR"
    cat > "$TEST_DIR/AGENTS.md" << 'EOF'
# AI Agent Guidelines - CV

> **Languages**: javascript
> **Type**: general

<!-- GOLDEN:framework:start -->

## Quality Gates (MANDATORY)

Before ANY commit:
1. **Verify claims**: Cross-reference against source materials
2. **Grep audit**: `grep -r "AI/ML" sources`

**Zero tolerance for fabricated claims.**

<!-- GOLDEN:framework:end -->

UNIQUE_TAIL_LINE
EOF

    run "$GENERATE_SCRIPT" --upgrade --apply --path="$TEST_DIR"
    [ "$status" -eq 0 ]
    grep -F '1. **Verify claims**: Cross-reference against source materials' "$TEST_DIR/AGENTS.md"
    grep -F '**Zero tolerance for fabricated claims.**' "$TEST_DIR/AGENTS.md"
    grep -qxF 'UNIQUE_TAIL_LINE' "$TEST_DIR/AGENTS.md"
    # The relocated block sits below the framework, and the tail is still last.
    awk '
        index($0, "<!-- GOLDEN:framework:end -->") { seen = 1 }
        seen && index($0, "Verify claims") { found = 1 }
        END { exit !found }
    ' "$TEST_DIR/AGENTS.md"
    cp "$TEST_DIR/AGENTS.md" "$TEST_DIR/AGENTS.md.once"
    run "$GENERATE_SCRIPT" --upgrade --apply --path="$TEST_DIR"
    [ "$status" -eq 0 ]
    cmp "$TEST_DIR/AGENTS.md.once" "$TEST_DIR/AGENTS.md"
}

@test "upgrade reads a header whose colon sits inside the bold markers" {
    mkdir -p "$TEST_DIR"
    cat > "$TEST_DIR/AGENTS.md" << 'EOF'
# AI Agent Guidelines - Bloginator

> **Languages:** python
> **Type:** cli-tools

<!-- GOLDEN:framework:start -->

## Quality Gates

1. **Lint**: `ruff check .`
2. **Test**: `pytest`

<!-- GOLDEN:framework:end -->

UNIQUE_TAIL_LINE
EOF

    run "$GENERATE_SCRIPT" --upgrade --apply --path="$TEST_DIR"
    [ "$status" -eq 0 ]
    grep -F '`.golden-agents/modules/python.md`' "$TEST_DIR/AGENTS.md"
    grep -F '`.golden-agents/modules/cli-tools.md`' "$TEST_DIR/AGENTS.md"
    grep -F '1. **Lint**: `ruff check .`' "$TEST_DIR/AGENTS.md"
    grep -F '**Test**: `pytest`' "$TEST_DIR/AGENTS.md"
    grep -qxF 'UNIQUE_TAIL_LINE' "$TEST_DIR/AGENTS.md"
}

@test "second upgrade does not back up a redirect that already matches" {
    create_agents_with_markers "$TEST_DIR"
    printf '# Claude Code Instructions\n\nSee **[AGENTS.md](./AGENTS.md)** for all AI guidance.\n' > "$TEST_DIR/CLAUDE.md"
    run "$GENERATE_SCRIPT" --upgrade --apply --language=go --path="$TEST_DIR"
    [ "$status" -eq 0 ]
    rm -f "$TEST_DIR"/CLAUDE.md.*.bak
    run "$GENERATE_SCRIPT" --upgrade --apply --language=go --path="$TEST_DIR"
    [ "$status" -eq 0 ]
    [ ! -e "$TEST_DIR"/CLAUDE.md.*.bak ]
}
