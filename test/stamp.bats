#!/usr/bin/env bats
# Stamp comment replaces the visible Last Updated line.

load 'test_helper'

setup() {
    TEST_DIR="$(mktemp -d)"
    export TEST_DIR
}

teardown() {
    [[ -d "$TEST_DIR" ]] && rm -rf "$TEST_DIR"
}

framework_version() {
    # shellcheck disable=SC2046
    awk -F'"' '/^FRAMEWORK_VERSION=/ { print $2; exit }' $(implementation_files)
}

set_stamp_date() {
    local file="$1"
    local date="$2"
    local tmp="$file.stamp-rewrite"
    awk -v date="$date" '
        index($0, "<!-- golden-agents:stamp ") == 1 {
            sub(/updated=[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/, "updated=" date)
        }
        { print }
    ' "$file" > "$tmp"
    mv "$tmp" "$file"
}

@test "fresh generation writes a stamp and no Last Updated line" {
    run "$GENERATE_SCRIPT" --language=go --path="$TEST_DIR"
    [ "$status" -eq 0 ]
    grep -q '<!-- golden-agents:stamp version=' "$TEST_DIR/AGENTS.md"
    ! grep -q 'Last Updated' "$TEST_DIR/AGENTS.md"
    grep -q '> \*\*Generated by\*\*:' "$TEST_DIR/AGENTS.md"
    grep -q '> \*\*Languages\*\*:' "$TEST_DIR/AGENTS.md"
    grep -q '> \*\*Type\*\*:' "$TEST_DIR/AGENTS.md"
}

@test "full generation writes a stamp and no Last Updated line" {
    run "$GENERATE_SCRIPT" --full --language=shell --path="$TEST_DIR"
    [ "$status" -eq 0 ]
    grep -q '<!-- golden-agents:stamp version=' "$TEST_DIR/AGENTS.md"
    ! grep -q 'Last Updated' "$TEST_DIR/AGENTS.md"
}

@test "stamp version matches FRAMEWORK_VERSION" {
    local ver
    ver=$(framework_version)
    [ -n "$ver" ]
    run "$GENERATE_SCRIPT" --language=shell --path="$TEST_DIR"
    [ "$status" -eq 0 ]
    grep -F "<!-- golden-agents:stamp version=${ver} updated=" "$TEST_DIR/AGENTS.md"
}

@test "upgrade keeps stamp date when framework bytes are unchanged" {
    run "$GENERATE_SCRIPT" --language=go --type=cli-tools --path="$TEST_DIR"
    [ "$status" -eq 0 ]
    set_stamp_date "$TEST_DIR/AGENTS.md" "2020-01-15"
    run "$GENERATE_SCRIPT" --upgrade --apply --path="$TEST_DIR"
    [ "$status" -eq 0 ]
    grep -q 'updated=2020-01-15' "$TEST_DIR/AGENTS.md"
    ! grep -q 'Last Updated' "$TEST_DIR/AGENTS.md"
}

@test "upgrade refreshes stamp when framework bytes change" {
    local ver today
    ver=$(framework_version)
    today=$(date +%Y-%m-%d)
    run "$GENERATE_SCRIPT" --language=go --path="$TEST_DIR"
    [ "$status" -eq 0 ]
    set_stamp_date "$TEST_DIR/AGENTS.md" "2020-01-15"
    awk '
        index($0, "<!-- GOLDEN:framework:start -->") { print; print "FRAMEWORK_MUTATION"; next }
        { print }
    ' "$TEST_DIR/AGENTS.md" > "$TEST_DIR/mutated"
    mv "$TEST_DIR/mutated" "$TEST_DIR/AGENTS.md"
    run "$GENERATE_SCRIPT" --upgrade --apply --path="$TEST_DIR"
    [ "$status" -eq 0 ]
    grep -F "<!-- golden-agents:stamp version=${ver} updated=${today} -->" "$TEST_DIR/AGENTS.md"
    ! grep -q 'updated=2020-01-15' "$TEST_DIR/AGENTS.md"
    ! grep -q 'FRAMEWORK_MUTATION' "$TEST_DIR/AGENTS.md"
}

@test "upgrade inserts a stamp when the file has none" {
    local ver today
    ver=$(framework_version)
    today=$(date +%Y-%m-%d)
    create_agents_with_markers "$TEST_DIR"
    ! grep -q '<!-- golden-agents:stamp ' "$TEST_DIR/AGENTS.md"
    run "$GENERATE_SCRIPT" --upgrade --apply --no-backup --path="$TEST_DIR"
    [ "$status" -eq 0 ]
    grep -F "<!-- golden-agents:stamp version=${ver} updated=${today} -->" "$TEST_DIR/AGENTS.md"
}
