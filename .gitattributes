# Auto-detect text files and normalize line endings
* text=auto

# Shell scripts - always LF
*.sh text eol=lf
*.bash text eol=lf
*.bats text eol=lf

# PowerShell - LF in repo (CRLF on Windows via core.autocrlf / editor)
*.ps1 text eol=lf
*.psm1 text eol=lf

# Markdown - always LF for consistency
*.md text eol=lf

# YAML/JSON configs - always LF
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# Git/CI configs - always LF
.gitignore text eol=lf
.gitattributes text eol=lf

